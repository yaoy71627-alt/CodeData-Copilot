"""P0 failure injection: static diagnostics and both exports must survive."""
import copy
import html
import re
from pathlib import Path
from types import SimpleNamespace
from unittest.mock import patch

import pytest
import agent
import app
from report import build_markdown_report, build_pdf_report

ROOT = Path(__file__).resolve().parents[1]


def client_returning(text="## 1. 项目总结\n测试审查"):
    return SimpleNamespace(chat=SimpleNamespace(completions=SimpleNamespace(
        create=lambda **kwargs: SimpleNamespace(choices=[
            SimpleNamespace(message=SimpleNamespace(content=text))]))))


def run_pipeline(generate_ai=True):
    state = SimpleNamespace()
    with patch.object(app.st, "session_state", state):
        app.analyze_project_files([
            ("test.ipynb", ROOT / "demo_data/test.ipynb"),
            ("train.csv", ROOT / "demo_data/train.csv"),
        ], generate_ai=generate_ai)
    return state


@pytest.fixture
def baseline():
    with patch.object(agent, "get_client", return_value=client_returning()):
        return run_pipeline()


def assert_static_preserved(state, baseline):
    assert state.code_result == baseline.code_result
    assert state.data_results == baseline.data_results
    assert state.health == baseline.health
    assert state.repair_suggestions == baseline.repair_suggestions
    assert state.report_data["code_quality"] == baseline.report_data["code_quality"]
    assert state.report_data["data_quality"] == baseline.report_data["data_quality"]
    assert state.report_markdown
    assert state.report_pdf.startswith(b"%PDF")
    assert state.report_error is None


@pytest.mark.parametrize("failure,expected", [
    ("missing_dir", "read_failed"), ("unreadable", "read_failed"),
    ("encoding", "read_failed"), ("retrieval", "retrieval_failed"),
    ("empty", "empty"),
])
def test_knowledge_faults_preserve_static_and_export(failure, expected, baseline, tmp_path):
    if failure == "missing_dir":
        fault = patch.object(agent, "KNOWLEDGE_DIR", tmp_path / "absent")
    elif failure == "unreadable":
        fault = patch.object(Path, "read_text", side_effect=PermissionError("private payload"))
    elif failure == "encoding":
        fault = patch.object(agent, "load_knowledge_documents", side_effect=UnicodeError("bad encoding"))
    elif failure == "retrieval":
        fault = patch.object(agent, "retrieve_relevant_knowledge", side_effect=RuntimeError("private payload"))
    else:
        fault = patch.object(agent, "retrieve_relevant_knowledge", return_value="")
    # Restrict read fault to knowledge: all input fixtures are read as bytes.
    with fault, patch.object(agent, "get_client", return_value=client_returning()):
        state = run_pipeline()
    assert_static_preserved(state, baseline)
    assert state.enhancement_status["knowledge"]["status"] == expected
    assert state.enhancement_status["ai"]["status"] == "success"
    assert not state.enhancement_status["ai"]["used_knowledge"]
    assert expected in state.report_markdown
    assert "private payload" not in state.report_markdown


@pytest.mark.parametrize("failure,expected", [
    ("missing_key", "missing_api_key"), ("timeout", "timeout"), ("api", "api_failed"),
])
def test_ai_faults_preserve_static_and_export(failure, expected, baseline, monkeypatch):
    if failure == "missing_key":
        monkeypatch.delenv("DASHSCOPE_API_KEY", raising=False)
        fault = patch.object(agent, "KNOWLEDGE_DIR", ROOT / "knowledge")
    else:
        exc = TimeoutError("private payload") if failure == "timeout" else RuntimeError("private payload")
        fault = patch.object(agent, "get_client", side_effect=exc)
    with fault:
        state = run_pipeline()
    assert_static_preserved(state, baseline)
    assert state.enhancement_status["ai"]["status"] == expected
    assert expected in state.report_markdown
    assert "private payload" not in state.report_markdown


