def test_success_records_real_rules_and_sources(baseline):
    knowledge = baseline.enhancement_status["knowledge"]
    assert knowledge["sources"] and knowledge["rules"]
    assert baseline.enhancement_status["ai"]["used_knowledge"]
    for text in knowledge["sources"] + knowledge["rules"]:
        assert text in baseline.report_markdown


def test_refresh_failure_preserves_previous_results_and_records_failure(baseline):
    before = copy.deepcopy(baseline)
    with patch.object(app.st, "session_state", baseline), \
         patch.object(agent, "get_client", side_effect=TimeoutError("secret")), \
         patch.object(agent, "KNOWLEDGE_DIR", ROOT / "absent"):
        app.refresh_ai_review()
    assert_static_preserved(baseline, before)
    assert baseline.agent_report == before.agent_report
    assert baseline.enhancement_status["ai"]["previous_review_retained"]
    assert "上次成功结果" in baseline.report_markdown
    assert "timeout" in baseline.report_markdown


def test_no_ai_and_missing_knowledge_still_exports(baseline, tmp_path):
    with patch.object(agent, "KNOWLEDGE_DIR", tmp_path / "absent"):
        state = run_pipeline(generate_ai=False)
    assert_static_preserved(state, baseline)
    assert state.enhancement_status["ai"]["status"] == "disabled"


def test_pdf_contains_status_and_sources(baseline):
    # Capture PDF paragraph input to verify both exporters use the audit section.
    from reportlab.platypus import Paragraph
    captured = []
    def capture(text, *args, **kwargs):
        captured.append(html.unescape(re.sub(r"<[^>]+>", "", text)))
        return Paragraph(text, *args, **kwargs)
    with patch("reportlab.platypus.Paragraph", side_effect=capture):
        assert build_pdf_report(baseline.report_data).startswith(b"%PDF")
    assert any("知识库用于本次 AI Review" in text for text in captured)
    assert any(baseline.enhancement_status["knowledge"]["sources"][0] in text for text in captured)


def test_api_client_has_bounded_timeout_and_no_retries(monkeypatch):
    monkeypatch.setenv("DASHSCOPE_API_KEY", "test-placeholder")
    with patch("openai.OpenAI") as ctor:
        agent.get_client()
    assert ctor.call_args.kwargs["timeout"] == 30.0
    assert ctor.call_args.kwargs["max_retries"] == 0


def test_empty_directory_and_recovery(tmp_path):
    with patch.object(agent, "KNOWLEDGE_DIR", tmp_path):
        assert agent.safe_retrieve_knowledge([], [])[1]["status"] == "read_failed"
        (tmp_path / "code_quality.md").write_text("# Example Rules\n- Check code quality", encoding="utf-8")
        context, status = agent.safe_retrieve_knowledge([], [])
        assert status["status"] == "success"
        assert "Check code quality" in context
        (tmp_path / "code_quality.md").unlink()
        assert agent.safe_retrieve_knowledge([], [])[1]["status"] == "read_failed"


def test_real_sdk_timeout_at_completion_preserves_static(baseline):
    from openai import APITimeoutError
    timeout = APITimeoutError(request=SimpleNamespace(method="POST", url="https://example.invalid"))
    client = client_returning()
    client.chat.completions.create = lambda **kwargs: None
    with patch.object(client.chat.completions, "create", side_effect=timeout), \
         patch.object(agent, "get_client", return_value=client):
        state = run_pipeline()
    assert_static_preserved(state, baseline)
    assert state.enhancement_status["ai"]["status"] == "timeout"


def test_ai_page_and_refresh_render_without_knowledge(baseline, tmp_path):
    from streamlit.testing.v1 import AppTest
    at = AppTest.from_file(str(ROOT / "app.py"), default_timeout=20)
    for key, value in vars(baseline).items():
        at.session_state[key] = value
    at.session_state["active_page"] = "AI Review"
    with patch.object(agent, "KNOWLEDGE_DIR", tmp_path / "absent"), \
         patch.object(agent, "get_client", side_effect=TimeoutError("private payload")):
        at.run()
        assert not at.exception
        button = next(b for b in at.button if b.label == "Generate / refresh AI Review")
        button.click().run()
        assert not at.exception
    assert at.session_state["enhancement_status"]["knowledge"]["status"] == "read_failed"
    assert at.session_state["enhancement_status"]["ai"]["status"] == "timeout"
    assert at.session_state["code_result"] == baseline.code_result
    assert at.session_state["report_pdf"].startswith(b"%PDF")
    assert any("超时" in w.value for w in at.warning)
