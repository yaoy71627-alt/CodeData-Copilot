def test_local_legacy_correction_retains_valid_neighboring_sentences(facts):
    text = "建议使用训练集拟合预处理器。模型准确率显著下降。请独立保留最终测试集。"
    corrected, notes = validate_agent_consistency(text, facts)
    assert "建议使用训练集拟合预处理器。" in corrected
    assert "请独立保留最终测试集。" in corrected
    assert "模型准确率显著下降" not in corrected
    assert "Unable to verify automatically" not in corrected
    assert notes


def test_observed_error_and_manual_review_are_distinguished():
    code = [{"file": "bad.py", "issues": analyze_code_with_ast("def :\n") }]
    data = [{"file": "data.csv", "result": {"issues": [
        {"rule_id": "DQ_NON_FINITE_NUMERIC", "type": "Nonfinite", "issue_nature": "Confirmed Invalid",
         "severity": "High", "confidence": "High", "count": 2},
        {"rule_id": "DQ_OUTLIER", "type": "Outlier", "issue_nature": "Statistical Anomaly",
         "severity": "Medium", "confidence": "High", "count": 3},
    ]}}]
    items = build_findings(code, data)
    assert {f["type"]: f["verification_status"] for f in items} == {
        "Syntax Error": "confirmed_error", "Nonfinite": "confirmed_error", "Outlier": "needs_review",
    }
    assert next(f for f in items if f["type"] == "Nonfinite")["detected_count"] == 2


def test_cardekho_feature_reuse_is_not_proven_entity_leakage(tmp_path):
    path = tmp_path / "cardekho.csv"
    pd.DataFrame({"row_number": range(12), "car_name": ["sedan", "suv"] * 6,
                  "target": range(12)}).to_csv(path, index=False)
    source = '''X = df[["car_name"]]
y = df["target"]
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.5, random_state=17)
'''
    flow = analyze_python_data_flow(source)
    result = analyze_csv(path, data_flow=flow)
    facts = build_analysis_facts([], [{"file": path.name, "result": result}], flow,
                                 duplicate_split_analysis=result["duplicate_split_analysis"])
    finding = next(f for f in facts["findings"] if f["rule_id"] == "DQ_CROSS_SPLIT_FEATURE_COMBINATIONS")
    assert finding["severity"] == "Low" and finding["confidence"] == "Medium"
    assert finding["verification_status"] == "needs_review"
    review = render_structured_review({"explanations": [{"finding_id": finding["id"],
        "cause": "相同车型说明已确认实体泄漏。", "potential_impact": "性能严重高估。"}]}, facts)
    assert "相同车型说明已确认实体泄漏" not in review
    assert "性能严重高估" not in review
    assert "需要人工复核" in review


def test_agent_json_contract_and_format_fallback(facts):
    code = [{"file": i["file"], "issues": [i]} for i in facts["formal_code_issues"]]
    def fake_create(**kwargs):
        assert kwargs["response_format"] == {"type": "json_object"}
        prompt = kwargs["messages"][1]["content"]
        assert "finding_id" in prompt and "analysis_facts" in prompt
        assert facts["findings"][0]["id"] in prompt
        return SimpleNamespace(choices=[SimpleNamespace(message=SimpleNamespace(content="not json"))])
    client = SimpleNamespace(chat=SimpleNamespace(completions=SimpleNamespace(create=fake_create)))
    with patch.object(agent, "get_client", return_value=client):
        review = agent.run_agent(code, [], analysis_facts=facts, knowledge_context="")
    assert "未返回有效的结构化解释" in review
    for f in facts["findings"]:
        assert f["id"] in review


def test_canonical_review_validation_is_idempotent_and_evidence_unchanged(facts):
    review = render_structured_review({}, facts)
    checked, _ = validate_agent_consistency(review, facts)
    twice, _ = validate_agent_consistency(checked, facts)
    assert twice == checked
    for f in facts["findings"]:
        assert str(f["evidence"]) in twice


