def test_explicit_upstream_verification_and_counts_are_not_rewritten():
    original = [{"file": "example.py", "cell": 4, "issues": [{
        "rule_id": "EXAMPLE", "type": "Example", "line": 5,
        "severity": "Medium", "confidence": "Low", "count": 7, "rate": 0.25,
        "verification_status": "needs_review", "evidence": "原始计数与验证结果。",
    }]}]
    finding = build_findings(original, [])[0]
    assert finding["verification_status"] == "needs_review"
    assert finding["detected_count"] == 7 and finding["detected_rate"] == 0.25
    assert finding["location"]["cell"] == 4 and finding["location"]["line"] == 5
    review = render_structured_review({}, {"findings": [finding]})
    assert "检测数量：7" in review and "检测比例（原始值）：0.25" in review


def test_id_does_not_change_when_evidence_count_or_severity_updates():
    raw = [{"file": "data.csv", "result": {"issues": [{
        "rule_id": "DQ_EXAMPLE", "type": "Example", "column": "age", "count": 2,
        "severity": "Medium", "confidence": "High", "evidence": "发现2条记录。",
    }]}}]
    first = build_findings([], raw)[0]
    revised = copy.deepcopy(raw)
    revised[0]["result"]["issues"][0].update(count=3, severity="Low", evidence="发现3条记录。")
    second = build_findings([], revised)[0]
    assert first["id"] == second["id"]
    assert first["severity"] == "Medium" and second["severity"] == "Low"


