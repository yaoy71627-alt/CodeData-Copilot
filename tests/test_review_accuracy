def test_repeated_explanations_are_grouped_without_dropping_ids(facts):
    text = "建议核查预处理的拟合范围。"
    payload = {"explanations": [{"finding_id": f["id"], "cause": text} for f in facts["findings"]]}
    review = render_structured_review(payload, facts)
    assert review.count(text) == 1
    for f in facts["findings"]:
