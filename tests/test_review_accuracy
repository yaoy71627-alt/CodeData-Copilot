def test_valid_json_annotations_reach_pipeline_and_both_exports(tmp_path):
    import app
    path = tmp_path / "titanic.py"
    path.write_text(SOURCE, encoding="utf-8")
    state = SimpleNamespace()
    def create(**kwargs):
        # The prompt carries the immutable first-party ID; return explanations only.
        import re
        ids = list(dict.fromkeys(re.findall(r'"id": "(F-[a-f0-9-]+)"', kwargs["messages"][1]["content"])))
        assert ids
        payload = {"explanations": [{"finding_id": fid,
                   "cause": "预处理的拟合范围需要与训练集边界一致。",
                   "potential_impact": "若拟合时使用了测试数据，评估可能产生乐观偏差。",
                   "recommendation": "先划分数据，再仅在训练集上拟合预处理器。"} for fid in ids]}
        return SimpleNamespace(choices=[SimpleNamespace(message=SimpleNamespace(content=json.dumps(payload, ensure_ascii=False)))])
    client = SimpleNamespace(chat=SimpleNamespace(completions=SimpleNamespace(create=create)))
    with patch.object(app.st, "session_state", state), patch.object(agent, "get_client", return_value=client):
        app.analyze_project_files([("titanic.py", path)])
    assert state.analysis_error is None
    assert "预处理的拟合范围需要与训练集边界一致" in state.agent_report
    assert "先划分数据，再仅在训练集上拟合预处理器" in state.report_markdown
    assert state.report_pdf.startswith(b"%PDF")
    assert state.report_data["findings"] == state.analysis_facts["findings"]
    assert state.enhancement_status["ai"]["status"] == "success"


