SOURCE = '''from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import train_test_split
scaler = StandardScaler()
X = df[["age", "fare"]]
y = df["target"]
X = scaler.fit_transform(X)
X_train, X_test, y_train, y_test = train_test_split(X, y, random_state=42)
'''


@pytest.fixture
def facts():
    code = [{"file": "titanic.py", "issues": analyze_code_with_ast(SOURCE)}]
    return build_analysis_facts(code, [], analyze_python_data_flow(SOURCE))


def test_findings_keep_metadata_counts_locations_and_stable_ids(facts):
    original = copy.deepcopy(facts)
    assert facts["findings"]
    for finding in facts["findings"]:
        raw = next(i for i in facts["formal_code_issues"]
                   if i["rule_id"] == finding["rule_id"] and i.get("line") == finding["location"]["line"])
        assert finding["severity"] == raw["severity"]
        assert finding["confidence"] == raw["confidence"]
        assert finding["location"]["file"] == raw["file"]
        assert finding["evidence"] == raw["evidence"]
    rebuilt = build_findings([
        {"file": i["file"], "issues": [i]} for i in reversed(facts["formal_code_issues"])
    ], [])
    assert rebuilt == facts["findings"]
    assert facts == original


def test_high_confidence_leakage_stays_static_risk(facts):
    finding = next(f for f in facts["findings"] if f["type"] == "Data Leakage Risk")
    assert finding["confidence"] == "High"
    assert finding["verification_status"] == "static_risk"


@pytest.mark.parametrize("claim", [
    "模型准确率显著下降。", "性能严重高估。", "模型性能被严重高估。",
    "Accuracy significantly decreases.", "已经证实发生数据泄漏。",
    "准确率为0.93。", "训练集有9999行。", "下降三个百分点。",
    "建议调用 ghost_scaler.fit(X)。", "建议检查 `invented_target`。",
    "问题位于 invented.py。", "严重程度应升级为 Critical。", "存在医疗风险。",
])
def test_untrusted_local_claim_removed_without_losing_useful_advice(facts, claim):
    finding = facts["findings"][0]
    review = render_structured_review({"explanations": [{
        "finding_id": finding["id"],
        "cause": "建议核查预处理的拟合顺序。" + claim,
    }]}, facts)
    assert "建议核查预处理的拟合顺序。" in review
    assert claim not in review
    assert "Unable to verify automatically" not in review
    assert finding["id"] in review


def test_ai_cannot_override_fields_or_add_confirmed_findings(facts):
    original = copy.deepcopy(facts)
    fid = facts["findings"][0]["id"]
    review = render_structured_review({"explanations": [
        {"finding_id": fid, "severity": "Critical", "location": {"file": "invented.py"},
         "verification_status": "confirmed_error", "count": 9999,
         "cause": "建议核查拟合数据的范围。"},
        {"finding_id": "F-invented", "cause": "新增确定性错误。"},
    ], "unverified_suggestions": ["建议核查部署环境中的依赖一致性。"]}, facts)
    assert "Critical" not in review and "invented.py" not in review
    assert "F-invented" not in review and "新增确定性错误" not in review
    assert "待验证建议（不计入原始检测数量）" in review
    assert facts == original
    for finding in facts["findings"]:
        assert f"### {finding['id']} · {finding['type']}" in review


@pytest.mark.parametrize("payload", [None, {}, {"explanations": "invalid"}, [],
